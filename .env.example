# Use distinct development/preview configuration. No credentials are supplied here.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
# Supabase URL and publishable (or legacy anon) key; never use a service-role key for Auth.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Dedicated non-owner runtime LOGIN role inheriting learning_runtime; transaction pooler URL.
DATABASE_URL=
# Privileged direct/session connection for scripts only, never NEXT_PUBLIC or runtime credentials.
MIGRATION_DATABASE_URL=
# Explicitly designate a safe target before running db:migrate/db:seed. No production option.
DATABASE_CHANGE_TARGET=
# Optional network PostgreSQL automated suite; dedicated empty database ONLY.
C2_TEST_DATABASE_URL=
C2_TEST_DATABASE_DISPOSABLE=
