{
  "name": "kana-learning-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "resources:prepare": "tsx scripts/resources/prepare.ts",
    "resources:check": "tsx scripts/resources/check.ts",
    "test:native": "node --test tests/kana-baseline.test.mjs",
    "test:domain": "vitest run --config vitest.domain.config.mts",
    "test:frontend": "vitest run",
    "test:production": "node tests/production-smoke.mjs",
    "test": "npm run test:native && npm run test:domain && npm run test:frontend",
    "check": "npm run format:check && npm run resources:check && npm test && npm run lint && npm run typecheck && npm run build && npm run test:production",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/noto-serif-jp": "^5.3.1",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-slot": "1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "1.4.2",
    "lucide-react": "^0.454.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "^2.5.5",
    "wanakana": "5.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.11.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "kanji-data": "1.0.0",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.3.3",
    "typescript": "^5",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "prettier": "3.6.2"
  },
  "type": "module"
}
